# =============================================================================
# Glucose Horizon — Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env to Git!
# =============================================================================

# Groq Cloud API Key (Get a free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model ID (Defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Groq Reasoning Effort for GPT-OSS models: low | medium | high
GROQ_REASONING_EFFORT=medium

# Groq API Base URL (Optional, defaults to official Groq endpoint)
# For local models (e.g. Ollama with gpt-oss), you can set: http://localhost:11434/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Frontend CORS Origins (comma-separated)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
